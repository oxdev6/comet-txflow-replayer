{
  "name": "comet-txflow-replayer",
  "version": "1.1.0",
  "description": "CLI to replay and inspect Compound III (Comet) transactions from a flow.json log.",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "comet-txflow": "./tui.jsx"
  },
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dashboard": "cd web-dashboard && npm run dev",
    "start:api": "node server.js",
    "start:web": "NEXT_PUBLIC_API_BASE=http://localhost:3001 npm run dev --prefix web-dashboard",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run start:api\" \"npm run start:web\"",
    "copilot:scan": "node packages/copilot-cli/bin.js scan .",
    "copilot:apply:gas": "node packages/copilot-cli/bin.js apply . --rule ARBI-GASPRICE-001 --write",
    "copilot:apply:events": "node packages/copilot-cli/bin.js apply . --rule ARBI-EVENT-LARGE-005 --write"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@asset-projects/token-list": "^4.2.2",
    "@ethereumjs/common": "^10.0.0",
    "@ethereumjs/tx": "^10.0.0",
    "alchemy-sdk": "^3.6.2",
    "axios": "^1.11.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "ink": "^6.1.0",
    "meow": "^13.2.0",
    "react": "^19.1.1",
    "viem": "^2.33.2",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "concurrently": "^9.1.2"
  }
}
